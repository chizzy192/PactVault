# Copy to .env.local and fill in. .env.local is git-ignored.

# Devnet RPC used by the browser and the faucet API. Must be a devnet URL.
# Leave empty to use https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=

# Test USDC mint address on devnet (public).
NEXT_PUBLIC_USDC_MINT=

# SERVER ONLY. The faucet keypair's secret key as a JSON array of 64 numbers
# (the contents of the faucet keypair file). Never prefix with NEXT_PUBLIC_.
FAUCET_SECRET_KEY=
